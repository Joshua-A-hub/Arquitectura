{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://abc-software.pe/schemas/error.json",
  "title": "ErrorValidacion",
  "description": "Forma única de error de la API: código de negocio + lista de campos con mensaje legible.",
  "type": "object",
  "additionalProperties": false,
  "required": ["codigo", "errores"],
  "properties": {
    "codigo": {
      "type": "string",
      "enum": [
        "VALIDACION_ESQUEMA",
        "VALIDACION_NEGOCIO",
        "NO_ENCONTRADO",
        "CONFLICTO_CORRELATIVO",
        "XML_INVALIDO",
        "ERROR_ENVIO",
        "NO_AUTORIZADO"
      ]
    },
    "mensaje": { "type": "string", "maxLength": 300 },
    "errores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["campo", "mensaje"],
        "properties": {
          "campo": { "type": "string", "maxLength": 120 },
          "mensaje": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    }
  }
}
