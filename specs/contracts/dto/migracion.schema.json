{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://abc-software.pe/schemas/migracion.json",
  "title": "MigracionRequest",
  "description": "Lote de fichas del sistema legado. Cada ficha termina MIGRADA u OBSERVADA (RN-22).",
  "type": "object",
  "additionalProperties": false,
  "required": ["fichas"],
  "properties": {
    "fichas": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id_ficha", "fecha", "producto"],
        "properties": {
          "id_ficha": { "type": "string", "minLength": 1, "maxLength": 50 },
          "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "ingreso": { "type": ["string", "null"], "maxLength": 30 },
          "salida": { "type": ["string", "null"], "maxLength": 30 },
          "producto": { "type": "string", "minLength": 1, "maxLength": 200 },
          "nro_documento": { "type": "string", "maxLength": 50 },
          "origen_archivo": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
