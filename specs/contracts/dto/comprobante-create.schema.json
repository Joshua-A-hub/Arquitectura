{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://abc-software.pe/schemas/comprobante-create.json",
  "title": "ComprobanteCreate",
  "description": "Petición de emisión de factura (01) o boleta (03). Los totales NO se envían: se calculan en el dominio (RN-09).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tipo",
    "serie",
    "fecha_emision",
    "hora_emision",
    "moneda",
    "forma_pago",
    "cliente",
    "detalle"
  ],
  "properties": {
    "tipo": {
      "type": "string",
      "enum": ["01", "03"],
      "description": "Catálogo 1: 01 factura, 03 boleta"
    },
    "serie": {
      "type": "string",
      "pattern": "^[FB][0-9]{3}$",
      "description": "F### para factura, B### para boleta (RN-10)"
    },
    "fecha_emision": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "hora_emision": {
      "type": "string",
      "pattern": "^[0-2][0-9]:[0-5][0-9]:[0-5][0-9]$"
    },
    "moneda": {
      "type": "string",
      "enum": ["PEN", "USD"],
      "description": "Catálogo 2"
    },
    "tipo_operacion": {
      "type": "string",
      "pattern": "^[0-9]{4}$",
      "default": "0101",
      "description": "Catálogo 51"
    },
    "forma_pago": {
      "type": "string",
      "enum": ["CONTADO", "CREDITO"]
    },
    "cuotas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/cuota" }
    },
    "observaciones": {
      "type": "string",
      "maxLength": 500
    },
    "cliente": { "$ref": "#/definitions/cliente" },
    "detalle": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/definitions/linea" }
    }
  },
  "definitions": {
    "cliente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo_documento", "numero_documento", "razon_social"],
      "properties": {
        "tipo_documento": {
          "type": "string",
          "enum": ["0", "1", "4", "6", "7", "A"],
          "description": "Catálogo 8"
        },
        "numero_documento": { "type": "string", "minLength": 1, "maxLength": 15 },
        "razon_social": { "type": "string", "minLength": 3, "maxLength": 200 },
        "ubigeo": { "type": "string", "pattern": "^[0-9]{6}$" },
        "direccion": { "type": "string", "maxLength": 200 }
      }
    },
    "linea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numero_linea",
        "producto_codigo",
        "descripcion",
        "unidad_medida",
        "cantidad",
        "precio_unitario",
        "afectacion_igv"
      ],
      "properties": {
        "numero_linea": { "type": "integer", "minimum": 1 },
        "producto_codigo": { "type": "string", "minLength": 1, "maxLength": 30 },
        "descripcion": { "type": "string", "minLength": 3, "maxLength": 200 },
        "unidad_medida": {
          "type": "string",
          "enum": ["NIU", "KGM", "BX", "LTR", "ZZ"],
          "description": "Catálogo 3"
        },
        "cantidad": { "type": "number", "exclusiveMinimum": 0 },
        "precio_unitario": { "type": "number", "minimum": 0 },
        "descuento": { "type": "number", "minimum": 0 },
        "afectacion_igv": {
          "type": "string",
          "enum": ["10", "11", "20", "21", "30", "31", "40"],
          "description": "Catálogo 7"
        },
        "tasa_isc": { "type": "number", "minimum": 0, "maximum": 50 }
      }
    },
    "cuota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monto", "fecha_vencimiento"],
      "properties": {
        "monto": { "type": "number", "exclusiveMinimum": 0 },
        "fecha_vencimiento": { "type": "string", "format": "date" }
      }
    }
  }
}
